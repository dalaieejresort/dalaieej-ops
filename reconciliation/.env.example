# Standalone PostgreSQL database used only by the reconciliation tool.
RECONCILIATION_DATABASE_URL=

# Google OAuth web client with Gmail API enabled and gmail.readonly consent.
RECONCILIATION_GMAIL_CLIENT_ID=
RECONCILIATION_GMAIL_CLIENT_SECRET=
RECONCILIATION_GMAIL_REDIRECT_URI=http://localhost:3000/api/reconciliation/gmail/callback

# A private random value of at least 32 characters used to encrypt refresh tokens.
RECONCILIATION_TOKEN_ENCRYPTION_KEY=

# Exact Khan Bank source-account numbers accepted from the Yahoo mailbox.
# Separate multiple accounts with commas. Full numbers are compared in memory
# but only their final four digits are stored.
RECONCILIATION_YAHOO_KHAN_ACCOUNT_NUMBERS=
